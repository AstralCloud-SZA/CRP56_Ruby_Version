<+>/* ============================================================\r\n   GRAVITY COLLAPSE  —  Carrera / Tensura themed destruction page\r\n   Fully updated cinematic version for the animated renderer\r\n   Drop-in replacement for gravitycollapse.css\r\n   Relies on Base_style.css tokens (--space-*, --radius-*, --text-*)\r\n   ============================================================ */\r\n\r\n:root {\r\n    --gravity-bg:        #070402;\r\n    --gravity-bg-2:      #150c06;\r\n    --gravity-bg-3:      #241108;\r\n    --gravity-text:      #f6e7c8;\r\n    --gravity-muted:     rgba(246, 231, 200, 0.66);\r\n    --gravity-faint:     rgba(246, 231, 200, 0.42);\r\n\r\n    --gravity-border:    rgba(255, 196, 92, 0.18);\r\n    --gravity-border-2:  rgba(255, 196, 92, 0.40);\r\n    --gravity-border-hot: rgba(255, 126, 69, 0.52);\r\n\r\n    --gravity-gold:      #f2c14f;\r\n    --gravity-gold-2:    #ffdb7a;\r\n    --gravity-gold-3:    #ffe9b0;\r\n    --gravity-red:       #d34a1f;\r\n    --gravity-red-2:     #ff7a45;\r\n    --gravity-red-3:     #ffb18a;\r\n    --gravity-danger:    #ff5a3c;\r\n    --gravity-ok:        #7ad6a0;\r\n\r\n    --gold-gradient:     linear-gradient(135deg, #ffdb7a, #f2c14f 45%, #d34a1f);\r\n    --collapse-gradient: linear-gradient(135deg, #ffb56f, #ff7a45 36%, #d34a1f 68%, #6e1808 100%);\r\n    --ember-gradient:    radial-gradient(circle at center, rgba(255,190,92,0.26), rgba(211,74,31,0.14) 45%, rgba(0,0,0,0) 72%);\r\n\r\n    --glow:              0 0 22px rgba(242, 193, 79, 0.45);\r\n    --gravity-shadow:    0 24px 70px rgba(0, 0, 0, 0.6);\r\n    --collapse-shadow:\r\n            0 0 24px rgba(255, 120, 50, 0.18),\r\n            0 0 56px rgba(255, 120, 50, 0.14),\r\n            0 0 120px rgba(255, 90, 60, 0.10);\r\n\r\n    --shake-fast:        0.11s linear infinite;\r\n    --shake-med:         0.18s linear infinite;\r\n    --pulse-fast:        0.9s ease-in-out infinite;\r\n    --pulse-med:         1.6s ease-in-out infinite;\r\n    --ring-wave:         2.3s ease-out infinite;\r\n}\r\n\r\n* { box-sizing: border-box; }\r\nhtml, body { height: 100%; margin: 0; }\r\n\r\nbody[data-page=\"gravity-collapse\"] {\r\n    overflow: hidden;\r\n    color: var(--gravity-text);\r\n    background:\r\n            radial-gradient(circle at 50% 18%, rgba(255, 125, 61, 0.18), transparent 24%),\r\n            radial-gradient(circle at 50% 45%, rgba(242, 193, 79, 0.08), transparent 32%),\r\n            radial-gradient(circle at 50% 100%, rgba(90, 28, 10, 0.28), transparent 40%),\r\n            linear-gradient(160deg, var(--gravity-bg), var(--gravity-bg-2) 58%, #050302 100%);\r\n    font-family: var(--font-body, \"Inter\", system-ui, sans-serif);\r\n}\r\n\r\nbody[data-page=\"gravity-collapse\"] .bg-slides {\r\n    background:\r\n            radial-gradient(circle at center, rgba(255, 122, 69, 0.10), transparent 22%),\r\n            linear-gradient(180deg, rgba(0,0,0,0.94), rgba(12,7,5,0.97));\r\n}\r\n\r\n/* ---------- shell / layout ---------- */\r\n.shell {\r\n    display: grid;\r\n    grid-template-columns: 1fr 92px;\r\n    gap: var(--space-4, 16px);\r\n    height: 100vh;\r\n    padding: var(--space-4, 16px);\r\n}\r\n\r\n.gravity-chamber {\r\n    min-width: 0;\r\n    display: flex;\r\n    flex-direction: column;\r\n    border: 1px solid var(--gravity-border);\r\n    border-radius: calc(var(--radius-xl, 20px) + 4px);\r\n    background:\r\n            linear-gradient(180deg, rgba(255,255,255,0.03), transparent 24%),\r\n            linear-gradient(180deg, rgba(255,170,70,0.02), transparent 55%),\r\n            rgba(0,0,0,0.46);\r\n    box-shadow: var(--gravity-shadow);\r\n    overflow: hidden;\r\n    position: relative;\r\n}\r\n\r\n.gravity-chamber::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    inset: 0;\r\n    pointer-events: none;\r\n    background:\r\n            radial-gradient(circle at 50% 0%, rgba(255,220,150,0.04), transparent 26%),\r\n            linear-gradient(180deg, rgba(255,255,255,0.02), transparent 14%);\r\n    z-index: 0;\r\n}\r\n\r\n/* ---------- top bar ---------- */\r\n.gravity-topbar {\r\n    position: relative;\r\n    z-index: 2;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    gap: var(--space-4, 16px);\r\n    padding: var(--space-4, 16px) var(--space-5, 20px);\r\n    background: rgba(0,0,0,0.52);\r\n    border-bottom: 1px solid rgba(255,255,255,0.05);\r\n    backdrop-filter: blur(10px);\r\n}\r\n\r\n.brand-wrap { display: flex; align-items: center; gap: var(--space-3, 12px); }\r\n\r\n.brand-mark.gravity-mark\r\n{\r\n    width: 46px;\r\n    height: 46px;\r\n    display: grid;\r\n    place-items: center;\r\n    border-radius: 14px;\r\n    background: linear-gradient(135deg, rgba(255,219,122,0.95), rgba(211,74,31,0.95));\r\n    box-shadow: 0 0 22px rgba(242,193,79,0.30), inset 0 0 14px rgba(255,255,255,0.12);\r\n}\r\n\r\n.mini-black-hole {\r\n    width: 26px;\r\n    height: 26px;\r\n    border-radius: 50%;\r\n    background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.75), transparent 18%), radial-gradient(circle at center, rgba(14,10,18,0.9), rgba(0,0,0,1) 68%);\r\n    box-shadow:\r\n            0 0 0 5px rgba(255,210,120,0.06),\r\n            0 0 16px rgba(255,122,45,0.42),\r\n            0 0 28px rgba(255,170,70,0.20),\r\n            inset 0 0 10px rgba(255,255,255,0.08);\r\n    animation: miniOrbitGlow 2.8s ease-in-out infinite;\r\n}\r\n\r\n.eyebrow {\r\n    font-size: var(--text-xs, 11px);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.18em;\r\n    color: rgba(255,219,122,0.7);\r\n}\r\n\r\n.page-title {\r\n    margin: 2px 0 0;\r\n    font-family: var(--font-display, \"Inter\", sans-serif);\r\n    font-size: clamp(1.3rem, 1rem + 1vw, 1.8rem);\r\n    line-height: 1;\r\n    text-shadow: 0 0 18px rgba(255,180,90,0.10);\r\n}\r\n\r\n.top-controls { display: flex; gap: var(--space-2, 8px); align-items: center; }\r\n\r\n.chip {\r\n    font-size: var(--text-xs, 11px);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.12em;\r\n    padding: 0.45rem 0.7rem;\r\n    border-radius: 999px;\r\n    border: 1px solid var(--gravity-border);\r\n    white-space: nowrap;\r\n    backdrop-filter: blur(8px);\r\n}\r\n\r\n.danger-chip {\r\n    color: #ffd2a3;\r\n    border-color: rgba(255,122,69,0.35);\r\n    background: rgba(255,122,69,0.08);\r\n}\r\n\r\n.danger-chip[data-armed=\"true\"] {\r\n    color: #fff;\r\n    border-color: var(--gravity-danger);\r\n    background: rgba(255,90,60,0.22);\r\n    box-shadow:\r\n            0 0 16px rgba(255,90,60,0.35),\r\n            0 0 34px rgba(255,90,60,0.12);\r\n    animation: armBlink 1.1s ease-in-out infinite;\r\n}\r\n\r\n.gravity-badge {\r\n    color: var(--gravity-gold-2);\r\n    border-color: rgba(255,196,92,0.28);\r\n    background: rgba(255,255,255,0.03);\r\n}\r\n\r\n.gravity-badge[data-guard=\"off\"] {\r\n    color: var(--gravity-danger);\r\n    border-color: var(--gravity-danger);\r\n    background: rgba(255,90,60,0.1);\r\n}\r\n\r\n@keyframes armBlink {\r\n    0%,100% { opacity: 1; transform: translateY(0); }\r\n    50% { opacity: 0.58; transform: translateY(-1px); }\r\n}\r\n\r\n@keyframes miniOrbitGlow {\r\n    0%,100% {\r\n        transform: scale(1);\r\n        box-shadow:\r\n                0 0 0 5px rgba(255,210,120,0.06),\r\n                0 0 16px rgba(255,122,45,0.42),\r\n                0 0 28px rgba(255,170,70,0.20),\r\n                inset 0 0 10px rgba(255,255,255,0.08);\r\n    }\r\n    50% {\r\n        transform: scale(1.06);\r\n        box-shadow:\r\n                0 0 0 7px rgba(255,210,120,0.08),\r\n                0 0 20px rgba(255,122,45,0.52),\r\n                0 0 38px rgba(255,170,70,0.28),\r\n                inset 0 0 12px rgba(255,255,255,0.12);\r\n    }\r\n}\r\n\r\n/* ---------- main grid ---------- */\r\n.gravity-grid {\r\n    position: relative;\r\n    z-index: 1;\r\n    flex: 1;\r\n    display: grid;\r\n    grid-template-columns: 1.25fr 0.95fr;\r\n    gap: var(--space-5, 20px);\r\n    padding: var(--space-5, 20px);\r\n    min-height: 0;\r\n    overflow: hidden;\r\n}\r\n\r\n/* ---------- the singularity stage ---------- */\r\n.gravity-stage {\r\n    position: relative;\r\n    border: 1px solid var(--gravity-border);\r\n    border-radius: calc(var(--radius-xl, 20px) + 6px);\r\n    overflow: hidden;\r\n    background:\r\n            radial-gradient(circle at 50% 46%, rgba(255,190,92,0.12), transparent 18%),\r\n            radial-gradient(circle at 50% 50%, rgba(180,70,30,0.18), transparent 34%),\r\n            linear-gradient(180deg, rgba(10,7,5,0.94), rgba(4,3,2,0.99));\r\n    box-shadow:\r\n            inset 0 0 90px rgba(0,0,0,0.74),\r\n            inset 0 0 180px rgba(255,130,60,0.03),\r\n            0 0 42px rgba(255,170,70,0.08);\r\n    transition:\r\n            box-shadow 0.35s ease,\r\n            border-color 0.35s ease,\r\n            filter 0.35s ease;\r\n    isolation: isolate;\r\n}\r\n\r\n.singularity-canvas {\r\n    position: absolute;\r\n    inset: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    display: block;\r\n    z-index: 1;\r\n}\r\n\r\n/* global veil */\r\n.gravity-stage::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    inset: 0;\r\n    z-index: 2;\r\n    pointer-events: none;\r\n    background:\r\n            radial-gradient(circle at 50% 46%, transparent 0 14%, rgba(0,0,0,0.08) 21%, rgba(0,0,0,0.55) 61%, rgba(0,0,0,0.92) 100%),\r\n            linear-gradient(120deg, rgba(255,255,255,0.04), transparent 34%, rgba(255,255,255,0.02));\r\n    opacity: 1;\r\n    transition: opacity 0.3s ease;\r\n}\r\n\r\n/* inner frame */\r\n.gravity-stage::after {\r\n    content: \"\";\r\n    position: absolute;\r\n    inset: 14px;\r\n    z-index: 2;\r\n    pointer-events: none;\r\n    border-radius: inherit;\r\n    border: 1px solid rgba(255,185,97,0.12);\r\n    box-shadow:\r\n            inset 0 0 24px rgba(255,156,68,0.05),\r\n            inset 0 0 40px rgba(255,210,140,0.02);\r\n}\r\n\r\n/* cinematic overlays */\r\n.gravity-stage .stage-flare,\r\n.gravity-stage .stage-rings,\r\n.gravity-stage .stage-embers {\r\n    position: absolute;\r\n    inset: 0;\r\n    pointer-events: none;\r\n}\r\n\r\n.gravity-stage .stage-flare {\r\n    z-index: 2;\r\n    background:\r\n            radial-gradient(circle at 50% 46%, rgba(255,244,210,0.10), rgba(255,180,92,0.06) 10%, rgba(190,72,28,0.05) 22%, rgba(0,0,0,0) 44%);\r\n    mix-blend-mode: screen;\r\n    opacity: 0.75;\r\n}\r\n\r\n.gravity-stage .stage-rings {\r\n    z-index: 2;\r\n    background:\r\n            radial-gradient(circle at 50% 46%, transparent 0 13%, rgba(255,215,140,0.10) 14%, transparent 15.5%),\r\n            radial-gradient(circle at 50% 46%, transparent 0 19%, rgba(255,175,90,0.08) 20%, transparent 21.4%),\r\n            radial-gradient(circle at 50% 46%, transparent 0 27%, rgba(255,122,69,0.05) 28%, transparent 29.5%);\r\n    opacity: 0.36;\r\n    animation: ringBreathe 4.2s ease-in-out infinite;\r\n}\r\n\r\n.gravity-stage .stage-embers {\r\n    z-index: 2;\r\n    background:\r\n            radial-gradient(circle at 50% 46%, rgba(255,190,92,0.10), transparent 16%),\r\n            radial-gradient(circle at 36% 54%, rgba(255,122,69,0.05), transparent 12%),\r\n            radial-gradient(circle at 64% 40%, rgba(255,219,122,0.04), transparent 10%);\r\n    opacity: 0.8;\r\n    animation: emberPulse 3.8s ease-in-out infinite;\r\n}\r\n\r\n@keyframes ringBreathe {\r\n    0%,100% { transform: scale(1); opacity: 0.26; }\r\n    50% { transform: scale(1.025); opacity: 0.44; }\r\n}\r\n\r\n@keyframes emberPulse {\r\n    0%,100% { opacity: 0.52; filter: blur(0px); }\r\n    50% { opacity: 0.92; filter: blur(2px); }\r\n}\r\n\r\n/* stage state visuals */\r\n.gravity-stage[data-state=\"idle\"] {\r\n    border-color: rgba(255,196,92,0.14);\r\n}\r\n\r\n.gravity-stage[data-state=\"charged\"] {\r\n    border-color: var(--gravity-border-2);\r\n    box-shadow:\r\n            inset 0 0 90px rgba(0,0,0,0.70),\r\n            inset 0 0 120px rgba(255,170,70,0.04),\r\n            0 0 28px rgba(255,170,70,0.12),\r\n            0 0 60px rgba(255,170,70,0.18);\r\n}\r\n\r\n.gravity-stage[data-state=\"charged\"] .stage-rings {\r\n    opacity: 0.5;\r\n    animation-duration: 2.6s;\r\n}\r\n\r\n.gravity-stage[data-state=\"armed\"] {\r\n    border-color: rgba(255,122,69,0.58);\r\n    filter: saturate(1.08);\r\n    box-shadow:\r\n            inset 0 0 90px rgba(0,0,0,0.66),\r\n            inset 0 0 160px rgba(255,122,69,0.06),\r\n            0 0 36px rgba(255,122,69,0.18),\r\n            0 0 70px rgba(255,90,60,0.28),\r\n            0 0 120px rgba(255,90,60,0.10);\r\n}\r\n\r\n.gravity-stage[data-state=\"armed\"] .stage-flare {\r\n    opacity: 0.95;\r\n    animation: armedCorePulse 1.4s ease-in-out infinite;\r\n}\r\n\r\n.gravity-stage[data-state=\"armed\"] .stage-rings {\r\n    opacity: 0.6;\r\n    animation-duration: 1.6s;\r\n}\r\n\r\n.gravity-stage[data-state=\"collapsing\"] {\r\n    border-color: var(--gravity-danger);\r\n    animation: stageShake 0.11s linear infinite;\r\n    filter: saturate(1.14) contrast(1.04);\r\n    box-shadow:\r\n            inset 0 0 110px rgba(0,0,0,0.76),\r\n            inset 0 0 180px rgba(255,110,50,0.08),\r\n            0 0 40px rgba(255,90,60,0.24),\r\n            0 0 90px rgba(255,90,60,0.34),\r\n            0 0 180px rgba(255,170,70,0.12);\r\n}\r\n\r\n.gravity-stage[data-state=\"collapsing\"]::before {\r\n    opacity: 0.88;\r\n}\r\n\r\n.gravity-stage[data-state=\"collapsing\"] .stage-flare {\r\n    opacity: 1;\r\n    animation: collapseFlashPulse 0.65s ease-in-out infinite;\r\n}\r\n\r\n.gravity-stage[data-state=\"collapsing\"] .stage-rings {\r\n    opacity: 0.82;\r\n    animation: collapseRingWave 1.15s linear infinite;\r\n}\r\n\r\n.gravity-stage[data-state=\"collapsing\"] .stage-embers {\r\n    opacity: 1;\r\n    animation: emberFlicker 0.7s linear infinite;\r\n}\r\n\r\n.gravity-stage[data-state=\"done\"] {\r\n    border-color: var(--gravity-ok);\r\n    filter: saturate(1.02);\r\n    box-shadow:\r\n            inset 0 0 100px rgba(0,0,0,0.72),\r\n            inset 0 0 140px rgba(255,226,160,0.04),\r\n            0 0 36px rgba(255,214,120,0.10),\r\n            0 0 58px rgba(122,214,160,0.20),\r\n            0 0 88px rgba(122,214,160,0.10);\r\n}\r\n\r\n.gravity-stage[data-state=\"done\"] .stage-flare {\r\n    opacity: 0.55;\r\n    animation: doneAfterglow 2.2s ease-in-out infinite;\r\n}\r\n\r\n.gravity-stage[data-state=\"done\"] .stage-rings {\r\n    opacity: 0.22;\r\n    animation-duration: 3.6s;\r\n}\r\n\r\n@keyframes armedCorePulse {\r\n    0%,100% {\r\n        transform: scale(1);\r\n        opacity: 0.78;\r\n        filter: blur(0px);\r\n    }\r\n    50% {\r\n        transform: scale(1.02);\r\n        opacity: 1;\r\n        filter: blur(1px);\r\n    }\r\n}\r\n\r\n@keyframes collapseFlashPulse {\r\n    0%,100% {\r\n        opacity: 0.72;\r\n        filter: blur(0px);\r\n    }\r\n    50% {\r\n        opacity: 1;\r\n        filter: blur(3px);\r\n    }\r\n}\r\n\r\n@keyframes collapseRingWave {\r\n    0% {\r\n        transform: scale(0.96);\r\n        opacity: 0.4;\r\n    }\r\n    50% {\r\n        transform: scale(1.02);\r\n        opacity: 0.9;\r\n    }\r\n    100% {\r\n        transform: scale(1.08);\r\n        opacity: 0.28;\r\n    }\r\n}\r\n\r\n@keyframes emberFlicker {\r\n    0%,100% { opacity: 0.75; transform: translateY(0) scale(1); }\r\n    25% { opacity: 1; transform: translateY(-2px) scale(1.01); }\r\n    50% { opacity: 0.86; transform: translateY(1px) scale(1.03); }\r\n    75% { opacity: 1; transform: translateY(-1px) scale(1.01); }\r\n}\r\n\r\n@keyframes doneAfterglow {\r\n    0%,100% {\r\n        opacity: 0.42;\r\n        transform: scale(1);\r\n    }\r\n    50% {\r\n        opacity: 0.68;\r\n        transform: scale(1.018);\r\n    }\r\n}\r\n\r\n@keyframes stageShake {\r\n    0%   { transform: translate(0,0); }\r\n    20%  { transform: translate(-1px, 1px); }\r\n    40%  { transform: translate(1px, -1px); }\r\n    60%  { transform: translate(-2px, 0); }\r\n    80%  { transform: translate(1px, 1px); }\r\n    100% { transform: translate(0,0); }\r\n}\r\n\r\n/* readout (top-left of stage) */\r\n.stage-readout {\r\n    position: absolute;\r\n    top: var(--space-5, 20px);\r\n    left: var(--space-5, 20px);\r\n    z-index: 3;\r\n    max-width: 60%;\r\n}\r\n\r\n.kicker {\r\n    font-size: var(--text-xs, 11px);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.16em;\r\n    color: rgba(255,219,122,0.7);\r\n}\r\n\r\n.readout-line {\r\n    margin-top: 4px;\r\n    font-family: var(--font-display, monospace);\r\n    font-size: clamp(1rem, 0.7rem + 1vw, 1.4rem);\r\n    letter-spacing: 0.08em;\r\n    color: var(--gravity-gold-2);\r\n    text-shadow:\r\n            0 0 18px rgba(255,180,90,0.5),\r\n            0 0 36px rgba(255,122,69,0.12);\r\n}\r\n\r\n.readout-sub {\r\n    margin-top: 4px;\r\n    font-size: var(--text-sm, 13px);\r\n    color: var(--gravity-muted);\r\n    max-width: 40ch;\r\n}\r\n\r\n/* overlay (bottom of stage) */\r\n.stage-overlay {\r\n    position: absolute;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    z-index: 3;\r\n    padding: var(--space-6, 24px);\r\n    display: grid;\r\n    gap: var(--space-3, 12px);\r\n    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.42) 26%, rgba(0,0,0,0.84));\r\n}\r\n\r\n.stage-overlay h2 {\r\n    margin: 0;\r\n    font-family: var(--font-display, sans-serif);\r\n    font-size: clamp(1.5rem, 1rem + 2vw, 2.6rem);\r\n    line-height: 1;\r\n    max-width: 18ch;\r\n    text-shadow: 0 0 26px rgba(255,180,90,0.12);\r\n}\r\n\r\n.stage-overlay p {\r\n    margin: 0;\r\n    max-width: 60ch;\r\n    color: var(--gravity-muted);\r\n    line-height: 1.6;\r\n}\r\n\r\n/* collapse progress */\r\n.collapse-progress {\r\n    position: absolute;\r\n    left: var(--space-6,24px);\r\n    right: var(--space-6,24px);\r\n    bottom: var(--space-6,24px);\r\n    z-index: 4;\r\n    display: grid;\r\n    gap: var(--space-2,8px);\r\n    padding: var(--space-4,16px);\r\n    border: 1px solid rgba(255,122,69,0.4);\r\n    border-radius: var(--radius-lg,14px);\r\n    background: rgba(0,0,0,0.62);\r\n    backdrop-filter: blur(10px);\r\n    box-shadow:\r\n            inset 0 0 0 1px rgba(255,255,255,0.03),\r\n            0 0 34px rgba(255,90,60,0.10);\r\n}\r\n\r\n.cp-bar {\r\n    height: 12px;\r\n    border-radius: 999px;\r\n    overflow: hidden;\r\n    background: rgba(0,0,0,0.6);\r\n    border: 1px solid rgba(255,255,255,0.06);\r\n}\r\n\r\n.cp-fill\r\n{\r\n    width: 0%;\r\n    height: 100%;\r\n    background: linear-gradient(90deg, var(--gravity-red), var(--gravity-red-2), var(--gravity-gold-2));\r\n    box-shadow: 0 0 18px rgba(255,122,69,0.5), 0 0 36px rgba(255,122,69,0.15);\r\n    transition: width 0.2s ease;\r\n}\r\n\r\n.cp-meta\r\n{\r\n    display: flex;\r\n    justify-content: space-between;\r\n    font-size: var(--text-xs,11px);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.12em;\r\n    color: var(--gravity-muted);\r\n}\r\n\r\n.cp-file\r\n{\r\n    font-size: var(--text-xs,11px);\r\n    color: rgba(255,219,122,0.7);\r\n    font-family: monospace;\r\n    white-space: nowrap;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n}\r\n\r\n/* ---------- side controls ---------- */\r\n.gravity-side\r\n{\r\n    display: grid;\r\n    gap: var(--space-4,16px);\r\n    align-content: start;\r\n    overflow-y: auto;\r\n    padding-right: 4px;\r\n}\r\n\r\n.gravity-side::-webkit-scrollbar { width: 8px; }\r\n.gravity-side::-webkit-scrollbar-thumb\r\n{\r\n    background: rgba(255,196,92,0.2);\r\n    border-radius: 8px;\r\n}\r\n\r\n.system-panel.gravity-card\r\n{\r\n    border: 1px solid var(--gravity-border);\r\n    background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.16)), linear-gradient(180deg, rgba(255,170,70,0.02), transparent 58%);\r\n    backdrop-filter: blur(14px);\r\n    border-radius: var(--radius-xl,20px);\r\n    padding: var(--space-5,20px);\r\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 0 0 1px rgba(255,255,255,0.01);\r\n}\r\n\r\n.panel-title\r\n{\r\n    margin: 0 0 var(--space-4,16px);\r\n    font-family: var(--font-display, sans-serif);\r\n    font-size: var(--text-lg,16px);\r\n}\r\n\r\n/* target */\r\n.target-card\r\n{\r\n    padding: var(--space-4,16px);\r\n    border: 1px solid var(--gravity-border);\r\n    border-radius: var(--radius-lg,14px);\r\n    background: rgba(0,0,0,0.26);\r\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);\r\n}\r\n\r\n.target-card[data-blocked=\"true\"] {\r\n    border-color: var(--gravity-danger);\r\n    background: rgba(255,90,60,0.08);\r\n}\r\n\r\n.target-label,\r\n.mini-label\r\n{\r\n    font-size: var(--text-xs,11px);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.16em;\r\n    color: rgba(255,219,122,0.68);\r\n}\r\n\r\n.target-value\r\n{\r\n    margin-top: var(--space-2,8px);\r\n    font-size: var(--text-sm,13px);\r\n    color: var(--gravity-text);\r\n    word-break: break-all;\r\n    font-family: monospace;\r\n}\r\n\r\n.target-meta\r\n{\r\n    display: flex;\r\n    gap: var(--space-2,8px);\r\n    margin-top: var(--space-3,12px);\r\n    flex-wrap: wrap;\r\n}\r\n\r\n.tm-chip\r\n{\r\n    font-size: var(--text-xs,11px);\r\n    padding: 3px 8px;\r\n    border-radius: 999px;\r\n    border: 1px solid var(--gravity-border);\r\n    color: var(--gravity-muted);\r\n    background: rgba(255,255,255,0.02);\r\n}\r\n\r\n.target-actions\r\n{\r\n    display: flex;\r\n    gap: var(--space-2,8px);\r\n    margin-top: var(--space-4,16px);\r\n    flex-wrap: wrap;\r\n}\r\n\r\n.secondary-btn.gravity-btn,\r\n.theme-button\r\n{\r\n    cursor: pointer;\r\n    border-radius: var(--radius-sm,10px);\r\n    border: 1px solid rgba(255,196,92,0.22);\r\n    background: rgba(255,255,255,0.03);\r\n    color: var(--gravity-text);\r\n    padding: 0.6rem 0.9rem;\r\n    font-size: var(--text-sm,13px);\r\n    font-weight: 600;\r\n    transition: all 0.18s ease;\r\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);\r\n}\r\n\r\n.secondary-btn.gravity-btn:hover,\r\n.theme-button:hover\r\n{\r\n    border-color: var(--gravity-border-2);\r\n    background: rgba(255,255,255,0.06);\r\n    transform: translateY(-1px);\r\n}\r\n\r\n.gravity-btn:disabled,\r\n.theme-button:disabled\r\n{\r\n    opacity: 0.4;\r\n    cursor: not-allowed;\r\n    transform: none;\r\n}\r\n\r\n.warning-box\r\n{\r\n    margin-top: var(--space-4,16px);\r\n    padding: var(--space-4,16px);\r\n    border: 1px dashed rgba(255,122,69,0.4);\r\n    border-radius: var(--radius-lg,14px);\r\n    background: rgba(255,122,69,0.06);\r\n    color: rgba(255,210,163,0.88);\r\n    line-height: 1.5;\r\n    font-size: var(--text-sm,13px);\r\n    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.015);\r\n}\r\n\r\n.warning-box[data-blocked=\"true\"] {\r\n    border-color: var(--gravity-danger);\r\n    color: #ffd0c4;\r\n    background: rgba(255,90,60,0.1);\r\n}\r\n\r\n/* lock rows */\r\n.setting-row.gravity-row {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    gap: var(--space-4,16px);\r\n    padding: var(--space-3,12px) 0;\r\n    border-bottom: 1px solid rgba(255,255,255,0.04);\r\n}\r\n\r\n.setting-row.gravity-row:last-of-type { border-bottom: none; }\r\n.setting-copy { min-width: 0; }\r\n\r\n.subtle\r\n{\r\n    font-size: var(--text-xs,11px);\r\n    color: var(--gravity-muted);\r\n    margin-top: 2px;\r\n}\r\n\r\n.gravity-input\r\n{\r\n    width: 100%;\r\n    max-width: 200px;\r\n    min-height: 44px;\r\n    padding: 0.7rem 0.9rem;\r\n    border-radius: var(--radius-sm,10px);\r\n    border: 1px solid rgba(255,196,92,0.22);\r\n    background: rgba(0,0,0,0.36);\r\n    color: var(--gravity-text);\r\n    outline: none;\r\n    font-size: var(--text-sm,13px);\r\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);\r\n}\r\n\r\n.gravity-input:focus\r\n{\r\n    border-color: rgba(255,122,69,0.6);\r\n    box-shadow: 0 0 0 3px rgba(255,122,69,0.12), 0 0 22px rgba(255,122,69,0.08);\r\n}\r\n\r\nselect.gravity-input { cursor: pointer; }\r\n\r\n.lock-actions\r\n{\r\n    display: grid;\r\n    gap: var(--space-2,8px);\r\n    margin-top: var(--space-4,16px);\r\n}\r\n\r\n.gravity-mini-btn\r\n{\r\n    background: rgba(255,196,92,0.08);\r\n}\r\n\r\n.gravity-mini-btn:not(:disabled):hover\r\n{\r\n    background: rgba(255,196,92,0.16);\r\n}\r\n\r\n.gravity-execute\r\n{\r\n    background: linear-gradient(135deg, #ff7a45, #d34a1f);\r\n    color: #fff;\r\n    border-color: transparent;\r\n}\r\n\r\n.gravity-execute:not(:disabled)\r\n{\r\n    box-shadow: 0 0 20px rgba(255,90,60,0.35), 0 0 44px rgba(255,90,60,0.12);\r\n    animation: armBlink 1.4s ease-in-out infinite;\r\n}\r\n\r\n.gravity-execute:not(:disabled):hover\r\n{\r\n    transform: translateY(-1px);\r\n}\r\n\r\n/* threat meter */\r\n.threat-meter { display: grid; gap: var(--space-2,8px); }\r\n\r\n.threat-track\r\n{\r\n    height: 10px;\r\n    border-radius: 999px;\r\n    overflow: hidden;\r\n    background: rgba(0,0,0,0.45);\r\n    border: 1px solid rgba(255,255,255,0.05);\r\n}\r\n\r\n.threat-fill\r\n{\r\n    width: 6%;\r\n    height: 100%;\r\n    background: linear-gradient(90deg, rgba(255,122,69,0.95), rgba(242,193,79,0.95));\r\n    box-shadow: 0 0 16px rgba(255,122,69,0.28), 0 0 28px rgba(255,122,69,0.10);\r\n    transition: width 0.3s ease;\r\n}\r\n\r\n.threat-meta\r\n{\r\n    display: flex;\r\n    justify-content: space-between;\r\n    color: var(--gravity-muted);\r\n    font-size: var(--text-xs,11px);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.12em;\r\n}\r\n\r\n.status-list.gravity-status\r\n{\r\n    display: grid;\r\n    gap: var(--space-2,8px);\r\n    margin-top: var(--space-4,16px);\r\n}\r\n\r\n.status-card\r\n{\r\n    position: relative;\r\n    padding: var(--space-3,12px) var(--space-4,16px);\r\n    border: 1px solid var(--gravity-border);\r\n    border-radius: var(--radius-lg,14px);\r\n    background: rgba(0,0,0,0.24);\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 2px;\r\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);\r\n}\r\n\r\n.status-name { font-size: var(--text-sm,13px); font-weight: 600; }\r\n.status-detail { font-size: var(--text-xs,11px); color: var(--gravity-muted); }\r\n\r\n.status-card .dot\r\n{\r\n    position: absolute;\r\n    top: 50%;\r\n    right: var(--space-4,16px);\r\n    transform: translateY(-50%);\r\n    width: 10px;\r\n    height: 10px;\r\n    border-radius: 50%;\r\n    background: rgba(255,122,69,0.5);\r\n    box-shadow: 0 0 10px rgba(255,122,69,0.5);\r\n}\r\n\r\n.status-card[data-ok=\"true\"] .dot\r\n{\r\n    background: var(--gravity-ok);\r\n    box-shadow: 0 0 10px rgba(122,214,160,0.6);\r\n}\r\n\r\n.status-card[data-ok=\"true\"]\r\n{\r\n    border-color: rgba(122,214,160,0.3);\r\n}\r\n\r\n/* footer */\r\n.gravity-footer\r\n{\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    padding: var(--space-3,12px) var(--space-5,20px);\r\n    border-top: 1px solid rgba(255,255,255,0.05);\r\n    background: rgba(0,0,0,0.52);\r\n    font-size: var(--text-xs,11px);\r\n    color: var(--gravity-muted);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.12em;\r\n    position: relative;\r\n    z-index: 2;\r\n}\r\n\r\n/* ---------- rail ---------- */\r\n.rail\r\n{\r\n    border: 1px solid var(--gravity-border);\r\n    border-radius: var(--radius-xl,20px);\r\n    background: linear-gradient(180deg, rgba(0,0,0,0.88), rgba(0,0,0,0.72));\r\n    backdrop-filter: blur(18px);\r\n    box-shadow: var(--gravity-shadow);\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    gap: var(--space-6,24px);\r\n    padding: var(--space-5,20px) var(--space-3,12px);\r\n    border-left: 4px solid rgba(255,234,0,0.9);\r\n}\r\n\r\n.rail-logo\r\n{\r\n    display: grid;\r\n    place-items: center;\r\n    width: 100%;\r\n    padding-bottom: var(--space-5,20px);\r\n    color: var(--gravity-gold-2);\r\n    filter: drop-shadow(0 0 8px var(--gravity-gold));\r\n}\r\n\r\n.rail-nav { display: grid; gap: var(--space-3,12px); }\r\n\r\n.nav-btn\r\n{\r\n    min-height: 50px;\r\n    min-width: 56px;\r\n    border: 1px solid transparent;\r\n    background: transparent;\r\n    color: var(--gravity-muted);\r\n    display: grid;\r\n    place-items: center;\r\n    text-decoration: none;\r\n    font-size: var(--text-sm,13px);\r\n    font-weight: 600;\r\n    text-transform: uppercase;\r\n    transition: all 0.18s ease;\r\n    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);\r\n}\r\n\r\n.nav-btn.active\r\n{\r\n    color: #000;\r\n    background: var(--gold-gradient);\r\n    box-shadow: var(--glow);\r\n}\r\n\r\n.nav-btn:hover:not(.active)\r\n{\r\n    color: var(--gravity-text);\r\n    background: rgba(255,255,255,0.05);\r\n    transform: translateX(-3px);\r\n}\r\n\r\n.rail-bottom { margin-top: auto; }\r\n\r\n.rail-note\r\n{\r\n    font-size: var(--text-xs,11px);\r\n    line-height: 1.45;\r\n    text-align: center;\r\n    color: var(--gravity-muted);\r\n    letter-spacing: 0.08em;\r\n    text-transform: uppercase;\r\n    border: 1px dashed var(--gravity-border);\r\n    padding: var(--space-3,12px);\r\n}\r\n\r\n/* ---------- final seal dialog ---------- */\r\n.collapse-seal-dialog\r\n{\r\n    padding: 0;\r\n    border: none;\r\n    background: transparent;\r\n    max-width: min(560px, calc(100vw - 32px));\r\n    width: 100%;\r\n    overflow: visible;\r\n}\r\n\r\n.collapse-seal-dialog::backdrop\r\n{\r\n    background: radial-gradient(circle at center, rgba(255,122,69,0.14), rgba(0,0,0,0.74) 48%, rgba(0,0,0,0.92) 100%);\r\n    backdrop-filter: blur(10px);\r\n}\r\n\r\n.collapse-seal-panel {\r\n    position: relative;\r\n    display: grid;\r\n    gap: var(--space-4, 16px);\r\n    padding: var(--space-6, 24px);\r\n    border-radius: calc(var(--radius-xl, 20px) + 4px);\r\n    border: 1px solid rgba(255, 196, 92, 0.28);\r\n    background:\r\n            linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01)),\r\n            radial-gradient(circle at 50% 0%, rgba(255,190,92,0.08), transparent 32%),\r\n            linear-gradient(180deg, rgba(14,8,5,0.97), rgba(5,3,2,0.98));\r\n    box-shadow: 0 24px 90px rgba(0,0,0,0.65), 0 0 40px rgba(255,122,69,0.12), inset 0 0 0 1px rgba(255,255,255,0.03);\r\n    color: var(--gravity-text);\r\n}\r\n\r\n.seal-aura\r\n{\r\n    position: relative;\r\n    width: 132px;\r\n    height: 132px;\r\n    margin: 0 auto var(--space-2, 8px);\r\n    display: grid;\r\n    place-items: center;\r\n}\r\n\r\n.seal-core {\r\n    width: 34px;\r\n    height: 34px;\r\n    border-radius: 50%;\r\n    background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.88), rgba(255,222,170,0.4) 20%, rgba(0,0,0,0.94) 52%, rgba(0,0,0,1) 72%);\r\n    box-shadow: 0 0 0 10px rgba(255,210,120,0.05), 0 0 24px rgba(255,160,70,0.36), 0 0 56px rgba(255,90,60,0.18);\r\n    animation: sealCorePulse 1.8s ease-in-out infinite;\r\n}\r\n\r\n.seal-ring\r\n{\r\n    position: absolute;\r\n    inset: 50%;\r\n    border-radius: 50%;\r\n    transform: translate(-50%, -50%);\r\n    border: 1px solid rgba(255,210,120,0.30);\r\n    box-shadow: 0 0 24px rgba(255,170,70,0.18), inset 0 0 20px rgba(255,170,70,0.06);\r\n}\r\n\r\n.seal-ring-a\r\n{\r\n    width: 86px;\r\n    height: 86px;\r\n    animation: sealSpinA 5s linear infinite;\r\n}\r\n\r\n.seal-ring-b\r\n{\r\n    width: 122px;\r\n    height: 122px;\r\n    border-color: rgba(255,122,69,0.26);\r\n    animation: sealSpinB 8s linear infinite;\r\n}\r\n\r\n.seal-kicker\r\n{\r\n    font-size: var(--text-xs, 11px);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.18em;\r\n    color: rgba(255,219,122,0.74);\r\n    text-align: center;\r\n}\r\n\r\n.seal-title\r\n{\r\n    margin: 0;\r\n    text-align: center;\r\n    font-family: var(--font-display, \"Inter\", sans-serif);\r\n    font-size: clamp(1.45rem, 1rem + 1.2vw, 2rem);\r\n    line-height: 1.05;\r\n}\r\n\r\n.seal-copy\r\n{\r\n    margin: 0 auto;\r\n    max-width: 44ch;\r\n    text-align: center;\r\n    color: var(--gravity-muted);\r\n    line-height: 1.65;\r\n}\r\n\r\n.seal-target-box\r\n{\r\n    padding: var(--space-4, 16px);\r\n    border-radius: var(--radius-lg, 14px);\r\n    border: 1px solid rgba(255,122,69,0.24);\r\n    background: linear-gradient(180deg, rgba(255,122,69,0.08), rgba(255,255,255,0.01)), rgba(0,0,0,0.24);\r\n}\r\n\r\n.seal-label\r\n{\r\n    font-size: var(--text-xs, 11px);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.16em;\r\n    color: rgba(255,219,122,0.72);\r\n}\r\n\r\n.seal-target\r\n{\r\n    margin-top: var(--space-2, 8px);\r\n    font-family: monospace;\r\n    font-size: var(--text-sm, 13px);\r\n    color: var(--gravity-text);\r\n    word-break: break-all;\r\n}\r\n\r\n.seal-meta\r\n{\r\n    display: flex;\r\n    gap: var(--space-2, 8px);\r\n    flex-wrap: wrap;\r\n    margin-top: var(--space-3, 12px);\r\n    color: var(--gravity-faint, rgba(246, 231, 200, 0.42));\r\n    font-size: var(--text-xs, 11px);\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.12em;\r\n}\r\n\r\n.seal-meta span\r\n{\r\n    padding: 0.32rem 0.55rem;\r\n    border-radius: 999px;\r\n    border: 1px solid rgba(255,196,92,0.16);\r\n    background: rgba(255,255,255,0.02);\r\n}\r\n\r\n.seal-check\r\n{\r\n    display: flex;\r\n    gap: var(--space-3, 12px);\r\n    align-items: flex-start;\r\n    padding: var(--space-3, 12px) 0;\r\n    color: var(--gravity-muted);\r\n    line-height: 1.55;\r\n    font-size: var(--text-sm, 13px);\r\n}\r\n\r\n.seal-check input\r\n{\r\n    margin-top: 2px;\r\n    accent-color: var(--gravity-danger);\r\n    inline-size: 18px;\r\n    block-size: 18px;\r\n    flex: 0 0 auto;\r\n}\r\n\r\n.seal-actions\r\n{\r\n    display: flex;\r\n    gap: var(--space-3, 12px);\r\n    justify-content: flex-end;\r\n    flex-wrap: wrap;\r\n}\r\n\r\n@keyframes sealSpinA\r\n{\r\n    from { transform: translate(-50%, -50%) rotate(0deg); }\r\n    to   { transform: translate(-50%, -50%) rotate(360deg); }\r\n}\r\n\r\n@keyframes sealSpinB\r\n{\r\n    from { transform: translate(-50%, -50%) rotate(360deg) scale(1); }\r\n    50%  { transform: translate(-50%, -50%) rotate(180deg) scale(1.04); }\r\n    to   { transform: translate(-50%, -50%) rotate(0deg) scale(1); }\r\n}\r\n\r\n@keyframes sealCorePulse\r\n{\r\n    0%, 100%\r\n    {\r\n        transform: scale(1);\r\n        box-shadow: 0 0 0 10px rgba(255,210,120,0.05), 0 0 24px rgba(255,160,70,0.36), 0 0 56px rgba(255,90,60,0.18);\r\n    }\r\n    50%\r\n    {\r\n        transform: scale(1.08);\r\n        box-shadow: 0 0 0 14px rgba(255,210,120,0.07), 0 0 36px rgba(255,180,90,0.48), 0 0 78px rgba(255,90,60,0.24);\r\n    }\r\n}\r\n\r\n@media (max-width: 640px)\r\n{\r\n    .collapse-seal-panel { padding: var(--space-5, 20px); }\r\n    .seal-actions { flex-direction: column; }\r\n    .seal-actions > * { width: 100%; }\r\n}\r\n\r\n/* ---------- responsive ---------- */\r\n@media (max-width: 1080px)\r\n{\r\n    .gravity-grid\r\n    {\r\n        grid-template-columns: 1fr;\r\n        overflow-y: auto;\r\n    }\r\n    .gravity-stage {\r\n        min-height: 48vh;\r\n    }\r\n}\r\n\r\n@media (max-width: 980px)\r\n{\r\n    .rail { display: none; }\r\n    .shell { grid-template-columns: 1fr; }\r\n}\r\n\r\n@media (max-width: 720px)\r\n{\r\n    .target-actions { flex-direction: column; }\r\n    .setting-row.gravity-row { flex-direction: column; align-items: flex-start; }\r\n    .gravity-input { max-width: 100%; }\r\n    .stage-readout { max-width: 78%; }\r\n    .collapse-progress\r\n    {\r\n        left: var(--space-4,16px);\r\n        right: var(--space-4,16px);\r\n        bottom: var(--space-4,16px);\r\n    }\r\n}
