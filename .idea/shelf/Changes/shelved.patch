<+><!DOCTYPE html>\r\n<html lang=\"en\" data-theme=\"gravity-collapse\">\r\n<head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n    <title>Gravity Collapse</title>\r\n\r\n    <link rel=\"stylesheet\" href=\"./Base_style.css\" />\r\n    <link rel=\"stylesheet\" href=\"./gravitycollapse.css\" id=\"themeStylesheet\" />\r\n</head>\r\n<body data-page=\"gravity-collapse\">\r\n<div class=\"app\">\r\n    <div class=\"bg-slides\" aria-hidden=\"true\"></div>\r\n    <canvas id=\"particles\" aria-hidden=\"true\"></canvas>\r\n\r\n    <div class=\"shell\">\r\n        <main class=\"chamber gravity-chamber\">\r\n            <!-- ===================== TOP BAR ===================== -->\r\n            <header class=\"topbar gravity-topbar\">\r\n                <div class=\"brand-wrap\">\r\n                    <div class=\"brand-mark gravity-mark\" aria-hidden=\"true\">\r\n                        <div class=\"mini-black-hole\" id=\"blackHoleMark\"></div>\r\n                    </div>\r\n                    <div>\r\n                        <div class=\"eyebrow\">Carrera // Skill: Gravity Collapse</div>\r\n                        <h1 class=\"page-title\">Gravity Collapse</h1>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"top-controls\">\r\n                    <span class=\"chip danger-chip\" id=\"armChip\">Disarmed</span>\r\n                    <span class=\"chip gravity-badge\" id=\"guardChip\">System guard: ON</span>\r\n                </div>\r\n            </header>\r\n\r\n            <!-- ===================== MAIN GRID ===================== -->\r\n            <section class=\"gravity-grid\">\r\n\r\n                <!-- ----- LEFT: the singularity stage ----- -->\r\n                <article class=\"gravity-stage\" id=\"collapseStage\" data-state=\"idle\">\r\n                    <canvas id=\"singularityCanvas\" class=\"singularity-canvas\" aria-hidden=\"true\"></canvas>\r\n\r\n                    <div class=\"stage-readout\" id=\"stageReadout\">\r\n                        <span class=\"kicker\">Localized collapse field</span>\r\n                        <div class=\"readout-line\" id=\"readoutPhase\">CORE IDLE</div>\r\n                        <div class=\"readout-sub\" id=\"readoutSub\">Select a target to charge the singularity.</div>\r\n                    </div>\r\n\r\n                    <div class=\"stage-overlay\">\r\n                        <h2 id=\"stageTitle\">Seal the target. Draw it inward. Crush the field.</h2>\r\n                        <p id=\"stageBody\">\r\n                            A sealed destruction chamber modelled on Carrera's gravity collapse.\r\n                            Lock onto a folder or non-system drive, arm the sequence, and the\r\n                            singularity erases it pass by pass.\r\n                        </p>\r\n                    </div>\r\n\r\n                    <!-- collapse progress sweep -->\r\n                    <div class=\"collapse-progress\" id=\"collapseProgress\" hidden>\r\n                        <div class=\"cp-bar\"><div class=\"cp-fill\" id=\"cpFill\"></div></div>\r\n                        <div class=\"cp-meta\">\r\n                            <span id=\"cpLabel\">Collapsing…</span>\r\n                            <span id=\"cpPct\">0%</span>\r\n                        </div>\r\n                        <div class=\"cp-file\" id=\"cpFile\">&nbsp;</div>\r\n                    </div>\r\n                </article>\r\n\r\n                <!-- ----- RIGHT: controls ----- -->\r\n                <aside class=\"gravity-side\">\r\n\r\n                    <!-- Target -->\r\n                    <section class=\"system-panel gravity-card\">\r\n                        <h2 class=\"panel-title\">Target Node</h2>\r\n\r\n                        <div class=\"target-card\" id=\"targetCard\">\r\n                            <div class=\"target-label\">Selected path</div>\r\n                            <div class=\"target-value\" id=\"selectedTargetPath\">No target selected</div>\r\n                            <div class=\"target-meta\" id=\"targetMeta\" hidden>\r\n                                <span class=\"tm-chip\" id=\"tmType\">—</span>\r\n                                <span class=\"tm-chip\" id=\"tmItems\">—</span>\r\n                                <span class=\"tm-chip\" id=\"tmSize\">—</span>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"target-actions\">\r\n                            <button class=\"secondary-btn gravity-btn\" id=\"pickFolderBtn\" type=\"button\">Select Folder</button>\r\n                            <button class=\"secondary-btn gravity-btn\" id=\"pickDriveBtn\" type=\"button\">Select Drive</button>\r\n                            <button class=\"secondary-btn gravity-btn\" id=\"clearTargetBtn\" type=\"button\">Clear</button>\r\n                        </div>\r\n\r\n                        <div class=\"warning-box\" id=\"targetWarning\">\r\n                            Collapse is irreversible. The system drive, the app drive, and protected\r\n                            roots are blocked by the gravity guard.\r\n                        </div>\r\n                    </section>\r\n\r\n                    <!-- Lock -->\r\n                    <section class=\"system-panel gravity-card\">\r\n                        <h2 class=\"panel-title\">Collapse Lock</h2>\r\n\r\n                        <div class=\"setting-row gravity-row\">\r\n                            <div class=\"setting-copy\">\r\n                                <div class=\"mini-label\">Mode</div>\r\n                                <div class=\"subtle\">Overwrite passes before deletion.</div>\r\n                            </div>\r\n                            <select class=\"gravity-input\" id=\"wipeMode\">\r\n                                <option value=\"quick\">Quick (delete only)</option>\r\n                                <option value=\"single\" selected>Secure · 1 pass</option>\r\n                                <option value=\"dod\">DoD · 3 pass</option>\r\n                                <option value=\"gutmann\">Gutmann · 7 pass</option>\r\n                            </select>\r\n                        </div>\r\n\r\n                        <div class=\"setting-row gravity-row\">\r\n                            <div class=\"setting-copy\">\r\n                                <div class=\"mini-label\">Password</div>\r\n                                <div class=\"subtle\">Required to unlock the chamber.</div>\r\n                            </div>\r\n                            <input class=\"gravity-input\" id=\"collapsePassword\" type=\"password\" placeholder=\"Enter password\" autocomplete=\"off\" />\r\n                        </div>\r\n\r\n                        <div class=\"setting-row gravity-row\">\r\n                            <div class=\"setting-copy\">\r\n                                <div class=\"mini-label\">Confirm phrase</div>\r\n                                <div class=\"subtle\">Type COLLAPSE to arm.</div>\r\n                            </div>\r\n                            <input class=\"gravity-input\" id=\"collapseConfirm\" type=\"text\" placeholder=\"COLLAPSE\" autocomplete=\"off\" />\r\n                        </div>\r\n\r\n                        <div class=\"lock-actions\">\r\n                            <button class=\"theme-button gravity-mini-btn\" id=\"armBtn\" type=\"button\" disabled>Arm Sequence</button>\r\n                            <button class=\"theme-button gravity-execute\" id=\"executeBtn\" type=\"button\" disabled>Execute Collapse</button>\r\n                            <button class=\"secondary-btn gravity-btn\" id=\"abortBtn\" type=\"button\" hidden>Abort</button>\r\n                        </div>\r\n                    </section>\r\n\r\n                    <!-- Status -->\r\n                    <section class=\"system-panel gravity-card\">\r\n                        <h2 class=\"panel-title\">Threat Meter</h2>\r\n\r\n                        <div class=\"threat-meter\">\r\n                            <div class=\"threat-track\"><div class=\"threat-fill\" id=\"threatFill\"></div></div>\r\n                            <div class=\"threat-meta\">\r\n                                <span>Gravity pressure</span>\r\n                                <span id=\"threatLevel\">IDLE</span>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"status-list gravity-status\">\r\n                            <div class=\"status-card\" data-ok=\"false\" id=\"stTarget\">\r\n                                <div class=\"status-name\">Target lock</div>\r\n                                <div class=\"status-detail\">Pending</div>\r\n                                <span class=\"dot\"></span>\r\n                            </div>\r\n                            <div class=\"status-card\" data-ok=\"false\" id=\"stArm\">\r\n                                <div class=\"status-name\">Sequence</div>\r\n                                <div class=\"status-detail\">Disarmed</div>\r\n                                <span class=\"dot\"></span>\r\n                            </div>\r\n                            <div class=\"status-card\" data-ok=\"false\" id=\"stCollapse\">\r\n                                <div class=\"status-name\">Collapse state</div>\r\n                                <div class=\"status-detail\">Sealed</div>\r\n                                <span class=\"dot\"></span>\r\n                            </div>\r\n                        </div>\r\n                    </section>\r\n                </aside>\r\n            </section>\r\n\r\n            <footer class=\"footer-strip gravity-footer\">\r\n                <span>Gravity Collapse chamber online</span>\r\n                <span id=\"collapseStatus\">Awaiting target</span>\r\n            </footer>\r\n        </main>\r\n\r\n        <!-- ===================== RAIL ===================== -->\r\n        <aside class=\"rail\" aria-label=\"Primary navigation\">\r\n            <div class=\"rail-logo\" aria-hidden=\"true\">\r\n                <canvas id=\"blackHoleRail\" width=\"54\" height=\"54\"></canvas>\r\n            </div>\r\n            <nav class=\"rail-nav\">\r\n                <a class=\"nav-btn\" href=\"./home.html\" data-sfx=\"cursor\">Home</a>\r\n                <a class=\"nav-btn\" href=\"./encrypt.html\" data-sfx=\"cursor\">Enc</a>\r\n                <a class=\"nav-btn\" href=\"./decrypt.html\" data-sfx=\"cursor\">Dec</a>\r\n                <a class=\"nav-btn active\" href=\"./gravity_collapse.html\" data-sfx=\"cursor\">Collapse</a>\r\n                <a class=\"nav-btn\" href=\"./settings.html\" data-sfx=\"cursor\">Set</a>\r\n                <a class=\"nav-btn\" href=\"./about.html\" data-sfx=\"cursor\">About</a>\r\n            </nav>\r\n            <div class=\"rail-bottom\">\r\n                <div class=\"rail-note\">Gravity collapse shell active</div>\r\n            </div>\r\n        </aside>\r\n    </div>\r\n</div>\r\n\r\n<script src=\"./particle_system.js\"></script>\r\n<script src=\"./gravitional_collapse.js\"></script>\r\n<script src=\"./app.js\"></script>\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', () =>\r\n    {\r\n        if (window.ParticleFX && ParticleFX.blackHole)\r\n        {\r\n            ParticleFX.blackHole('blackHoleMark', 52, 28);\r\n            ParticleFX.blackHole('blackHoleRail', 54, 28);\r\n        }\r\n    });\r\n</script>\r\n</body>\r\n</html>
